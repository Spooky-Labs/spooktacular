require "digest"
require "tmpdir"
require "fileutils"

default_platform(:mac)

# Project root (Fastfile runs from fastlane/, so parent is root)
PROJECT_ROOT = File.expand_path("..", __dir__)
APP_BUNDLE = File.join(PROJECT_ROOT, "Spooktacular.app")
PKG_FILE = File.join(PROJECT_ROOT, "Spooktacular.pkg")
APP_IDENTIFIER = "com.spooktacular.app"

# Direct-distribution targets. Overridable so a fork can publish to its
# own repository and tap without editing this file.
GITHUB_REPO   = ENV["SPOOKTACULAR_GITHUB_REPO"] || "Spooky-Labs/spooktacular"
HOMEBREW_TAP  = ENV["SPOOKTACULAR_HOMEBREW_TAP"] || "spooky-labs/tap"
CASK_FILE     = File.join(PROJECT_ROOT, "Casks", "spooktacular.rb")

# Developer contact fields — sourced from .env so forks can override
# without editing the Fastfile. Defaults keep Spooktacular's canonical
# submission flow working without configuration.
#
# `env_or` treats both nil and empty string as "not set". Plain
# `ENV["X"] || default` breaks when something exports `X=` (empty),
# because Ruby's `||` treats "" as truthy and returns the empty
# string — which App Store Connect then rejects with
# "You must provide a value for the attribute 'contactEmail'".
def env_or(key, default)
  value = ENV[key]
  (value.nil? || value.empty?) ? default : value
end

TEAM_ID                 = env_or("FASTLANE_TEAM_ID",                 "4AM5US9G8B")
ITC_TEAM_ID             = env_or("FASTLANE_ITC_TEAM_ID",             TEAM_ID)
# `APPLE_ID` is the Apple Developer Account login — can't be
# changed without migrating the whole developer account.
APPLE_ID                = env_or("FASTLANE_APPLE_ID",                "davisperris@gmail.com")
CONTACT_FIRST_NAME      = env_or("FASTLANE_CONTACT_FIRST_NAME",      "Perris")
CONTACT_LAST_NAME       = env_or("FASTLANE_CONTACT_LAST_NAME",       "Davis")
# Customer-facing + Apple-reviewer contact email. Separate from
# the developer-account `APPLE_ID` so the public face of the app
# uses the canonical `help@` inbox (monitored by the team) while
# the developer account stays on its original login.
SUPPORT_EMAIL           = env_or("FASTLANE_SUPPORT_EMAIL",           "help@spookylabs.ai")
CONTACT_EMAIL           = env_or("FASTLANE_CONTACT_EMAIL",           SUPPORT_EMAIL)
APP_REVIEW_EMAIL        = env_or("FASTLANE_APP_REVIEW_EMAIL",        SUPPORT_EMAIL)
APP_FEEDBACK_EMAIL      = env_or("FASTLANE_APP_FEEDBACK_EMAIL",      SUPPORT_EMAIL)

# App Store Connect's contactPhone validator wants a digits-only
# string (fastlane's own example:
# https://docs.fastlane.tools/actions/upload_to_testflight/ shows
# `"5558675309"`), not E.164 or formatted. Accept any human-
# convenient input in the env var (`+1 (206) 555-1212`,
# `206.555.1212`, `+12065551212`) and strip everything that isn't
# a digit before handing it to pilot/deliver. The raw default
# `5550000000` falls in NANP's fictional range and will still fail
# Apple's real-carrier lookup — every real submission must set
# `FASTLANE_CONTACT_PHONE` to a reachable number.
CONTACT_PHONE_RAW       = env_or("FASTLANE_CONTACT_PHONE",           "5550000000")
CONTACT_PHONE           = CONTACT_PHONE_RAW.gsub(/\D/, "")

platform :mac do

  # Run fastlane's canonical pre-lane discipline exactly once, in
  # the place the docs tell us to.
  #
  # `ensure_bundle_exec` — per
  # https://docs.fastlane.tools/actions/ensure_bundle_exec — forces
  # every invocation to go through `bundle exec fastlane`, so the
  # pinned Gemfile.lock resolves dependencies identically on CI
  # and on a contributor's laptop. No-op when already under
  # bundler; fails loudly otherwise.
  #
  # `setup_ci` — per
  # https://docs.fastlane.tools/actions/setup_ci — creates a
  # temporary keychain so `match` can import certificates without
  # prompting, switches `match` to read-only, and sets up log
  # paths. Without it, builds can freeze forever on a hidden
  # keychain prompt. Guarded on `CI` so a developer running
  # `bundle exec fastlane beta` locally isn't forced into a
  # throwaway keychain.
  before_all do
    ensure_bundle_exec
    setup_ci if ENV["CI"]
  end

  # ──────────────────────────────────────────────────
  # Test
  # ──────────────────────────────────────────────────

  desc "Run all unit tests (parallel) with a false-green guard"
  lane :test do
    Dir.chdir(PROJECT_ROOT) do
      # `swift test` exits 0 on no-tests-ran (e.g. if a compile
      # crash silently skips the entire suite), which lets false-
      # green slip past CI. We tee the output and then require the
      # summary line — any deviation aborts the lane.
      #
      # `--skip SpooktacularUITests` excludes the XCUITest bundle
      # from the RUN phase (the target is still compiled by the
      # Xcode-build CI job for regression catches). SwiftPM can
      # host an XCUITest target for compile-only use, but
      # `XCUIApplication().launch()` aborts with SIGABRT at
      # runtime because SwiftPM can't wire a test-host application
      # bundle (Apple limit). Proper runtime coverage needs an
      # `.xcodeproj` with a UI Testing Bundle target — tracked as
      # a separate infra task.
      output = sh(
        "swift", "test", "--parallel", "--skip", "SpooktacularUITests",
        log: true
      )
      unless output.include?("Test run with") || output.include?("Executed ")
        UI.user_error!(
          "swift test produced no test-run summary — this is the " \
          "false-green pattern where a compile crash silently yields " \
          "exit 0 and zero tests. Inspect the log above for the real " \
          "failure."
        )
      end
    end

    # The root package's `swift test` above only builds/runs the
    # root package's own test targets — SwiftPM never reaches into
    # a local `.package(path:)` dependency's OWN test targets, only
    # its library products. The three clean-room SPICE packages
    # under `Packages/` (added on this branch, vendored into the
    # guest-tools clipboard bridge via `SpiceProtocol` /
    # `SpiceSerialTransport` / `SpiceGuestAgent`) therefore had 36
    # tests that compiled and passed locally but never ran in any
    # CI lane — a regression in the wire protocol's framing or
    # header encoding could ship inside every guest VM's clipboard
    # bridge with CI fully green. Run each package's own suite
    # explicitly, with the same false-green guard as the root run
    # above, so a compile crash in any one of them fails the lane
    # instead of silently reporting zero tests.
    spice_packages = %w[SpiceProtocol SpiceSerialTransport SpiceGuestAgent]
    spice_packages.each do |package|
      package_path = File.join(PROJECT_ROOT, "Packages", package)
      output = sh(
        "swift", "test", "--package-path", package_path,
        log: true
      )
      unless output.include?("Test run with") || output.include?("Executed ")
        UI.user_error!(
          "swift test --package-path Packages/#{package} produced no " \
          "test-run summary — this is the false-green pattern where a " \
          "compile crash silently yields exit 0 and zero tests. " \
          "Inspect the log above for the real failure."
        )
      end
    end
  end

  # ──────────────────────────────────────────────────
  # Build
  # ──────────────────────────────────────────────────

  desc "Build the .app bundle for local development"
  #
  # Wraps `./build-app.sh` (default debug mode) with the
  # **development** profile + cert match just installed locally.
  # `build-app.sh` embeds the matching provisioning profile and
  # signs every bundled component with it when one is found, and
  # strips restricted entitlements when it isn't — see
  # `build-app.sh`'s own comments near `PROVISIONING_PROFILE`.
  #
  # Prefer this lane (or `signing_dev && ./build-app.sh`) over
  # building in Xcode for local iteration.
  lane :build_dev do
    # Ensure profiles are installed & sigh env vars populated.
    # `signing_dev` is idempotent, so re-running on a machine
    # that already has the profile is a ~1s no-op.
    signing_dev

    identity = ENV["sigh_#{APP_IDENTIFIER}_development_macos_certificate-name"] || ""
    profile  = ENV["sigh_#{APP_IDENTIFIER}_development_macos_profile-path"] || ""

    Dir.chdir(PROJECT_ROOT) do
      sh(
        {
          "CODESIGN_IDENTITY" => identity,
          "PROVISIONING_PROFILE" => profile
        },
        "./build-app.sh"
      )
    end
    UI.success("Built Spooktacular.app — launch with `open Spooktacular.app`.")
  end

  desc "Build the .app bundle (release)"
  lane :build do
    identity = ENV["sigh_#{APP_IDENTIFIER}_appstore_macos_certificate-name"] || ""
    profile = ENV["sigh_#{APP_IDENTIFIER}_appstore_macos_profile-path"] || ""

    Dir.chdir(PROJECT_ROOT) do
      sh(
        { "CODESIGN_IDENTITY" => identity, "PROVISIONING_PROFILE" => profile },
        "./build-app.sh", "release"
      )
    end
  end

  # ──────────────────────────────────────────────────
  # Package — Create .pkg from .app
  # ──────────────────────────────────────────────────

  desc "Package the .app into a .pkg for App Store submission"
  lane :package do
    # Query the keychain for the installer cert match installed,
    # instead of string-interpolating a name. The previous
    # `"3rd Party Mac Developer Installer: Perris Davis (#{TEAM_ID})"`
    # fallback broke when `TEAM_ID` evaluated to an empty string
    # (Ruby's `||` treats "" as truthy, so `ENV[..] || default`
    # returns "" when FASTLANE_TEAM_ID is exported empty). Keychain
    # lookup returns the authoritative name match actually created —
    # `3rd Party Mac Developer Installer: <Person> (<TEAM_ID>)`
    # including the real team ID — so the identity always matches
    # what productbuild resolves.
    installer_identity = ENV["INSTALLER_CERT_NAME"].to_s.empty? ?
      sh(
        "security find-identity -v | " \
        "awk '/3rd Party Mac Developer Installer/ " \
        "{ sub(/^[^\"]+\"/, \"\"); sub(/\".*$/, \"\"); print; exit }'",
        log: false
      ).strip :
      ENV["INSTALLER_CERT_NAME"]

    UI.user_error!(
      "No '3rd Party Mac Developer Installer' cert in keychain — " \
      "did the `signing` lane run before `package`?"
    ) if installer_identity.empty?

    UI.message("Packaging with installer identity: #{installer_identity}")

    Dir.chdir(PROJECT_ROOT) do
      sh("productbuild",
         "--component", "Spooktacular.app", "/Applications",
         "--sign", installer_identity,
         "Spooktacular.pkg")
    end
    UI.success("Package created: #{PKG_FILE}")
  end

  # ──────────────────────────────────────────────────
  # Code Signing — match
  # ──────────────────────────────────────────────────

  desc "Sync code-signing certificates and profiles via match"
  lane :signing do
    # `setup_ci` already ran via `before_all`; match picks up the
    # temporary keychain automatically.
    api_key = get_api_key
    match(
      api_key: api_key,
      type: "appstore",
      additional_cert_types: ["mac_installer_distribution"],
      readonly: is_ci
    )
  end

  desc "Sync development cert + profile for local builds"
  #
  # Local builds need a *development* provisioning profile
  # matching the app's restricted entitlements (currently just
  # `com.apple.security.virtualization`). `bundle exec fastlane
  # signing_dev` downloads the profile and installs it under
  # `~/Library/MobileDevice/Provisioning Profiles/`, where
  # `build-app.sh` auto-discovers it by app-identifier.
  #
  # Auth: prefers App Store Connect API key env vars when set
  # (matches CI's non-interactive flow); otherwise falls through
  # to fastlane's default Apple-ID auth chain (interactive
  # keychain / `fastlane-session`). This is the canonical local-
  # dev shape — a developer on their own Mac should not need the
  # API key secret just to install a profile.
  lane :signing_dev do
    # Empty-string env vars are treated as unset. GitHub Actions
    # `env:` blocks export an empty string when the secret is
    # unresolved, and `ENV[..] || ""` treats "" as truthy in Ruby —
    # so we check `.empty?` explicitly to gate API-key use.
    args = {
      type: "development",
      readonly: is_ci
    }
    # The key material may arrive either way: CI supplies base64 in
    # APPLE_API_KEY_P8, a developer points APPLE_API_KEY_FILEPATH at the .p8
    # on disk. `ensure_api_key_on_disk` accepts both, so this gate has to as
    # well — it previously insisted on P8, silently rejected a perfectly good
    # FILEPATH setup, fell through to Apple-ID auth and failed with
    # "Unauthorized Access", which says nothing about the real cause.
    if !(ENV["APPLE_API_KEY_ID"] || "").empty? &&
       !(ENV["APPLE_API_ISSUER_ID"] || "").empty? &&
       (!(ENV["APPLE_API_KEY_P8"] || "").empty? ||
        !(ENV["APPLE_API_KEY_FILEPATH"] || "").empty?)
      args[:api_key] = get_api_key
    else
      # No API creds → fall through to Apple-ID interactive auth
      # (the local-dev flow; reads from Keychain or prompts).
      args[:username] = APPLE_ID
    end
    match(**args)
  end

  desc "Force-regenerate development profiles (revokes old, creates new)"
  #
  # Rescue lane for when provisioning profiles drift out of sync
  # with the bundle ID's capabilities — e.g. after enabling a new
  # capability on an already-provisioned bundle ID, you need the
  # *profile* regenerated so it inherits the new entitlement.
  # `match` without `force:` would re-use the existing (stale)
  # profile.
  #
  # Destructive: revokes the current macOS development profiles
  # at Apple, creates new ones, and force-pushes the encrypted
  # blobs to the match repo. Other machines on this team that
  # rely on match will silently re-sync on their next run.
  #
  # AppStore / distribution profiles are untouched; this lane
  # only regenerates `type: development`.
  lane :signing_dev_force do
    UI.important(
      "Force-regenerating development profiles — existing ones " \
      "will be revoked at Apple. Run this only when profile " \
      "drift is blocking a build."
    )
    api_key = get_api_key
    match(
      type: "development",
      platform: "macos",
      force: true,
      readonly: false,
      api_key: api_key
    )
  end

  # ──────────────────────────────────────────────────
  # Notarize — Direct distribution
  # ──────────────────────────────────────────────────

  desc "Notarize the .app for direct distribution"
  lane :notarize_app do
    api_key = get_api_key
    notarize(
      package: APP_BUNDLE,
      bundle_id: APP_IDENTIFIER,
      api_key: api_key,
      verbose: true,
      print_log: true
    )
    UI.success("Notarization complete — ticket stapled to #{APP_BUNDLE}")
  end

  # ──────────────────────────────────────────────────
  # Beta — TestFlight
  # ──────────────────────────────────────────────────

  desc "Build, package, and upload to TestFlight"
  lane :beta do |options|
    test
    signing
    build
    package

    api_key = get_api_key
    changelog = options[:changelog] || default_changelog

    pilot(
      api_key: api_key,
      app_identifier: APP_IDENTIFIER,
      app_platform: "osx",
      pkg: PKG_FILE,
      team_id: TEAM_ID,

      beta_app_description: app_description,
      beta_app_feedback_email: APP_FEEDBACK_EMAIL,

      beta_app_review_info: {
        contact_email: CONTACT_EMAIL,
        contact_first_name: CONTACT_FIRST_NAME,
        contact_last_name: CONTACT_LAST_NAME,
        contact_phone: CONTACT_PHONE,
        demo_account_required: false,
        notes: review_notes
      },

      changelog: changelog,

      localized_app_info: {
        "en-US" => {
          feedback_email: APP_FEEDBACK_EMAIL,
          marketing_url: "https://spooktacular.app",
          privacy_policy_url: "https://spooktacular.app/privacy.html",
          description: app_description
        }
      },

      localized_build_info: {
        "en-US" => { whats_new: changelog }
      },

      uses_non_exempt_encryption: false,
      demo_account_required: false,
      skip_submission: false,
      skip_waiting_for_build_processing: true,

      # Internal-only for now. App Store Connect auto-distributes
      # to all internal App Store Connect users who have access to
      # this app record; no `groups:` filter needed at this stage.
      #
      # External distribution will go here when there's a real
      # external beta group (pilot's `groups:` + `distribute_external:
      # true` lookup is against the *external* namespace, not the
      # internal one — internal group names like "Homies" are not
      # valid there). Keep `notify_external_testers: false` so pilot
      # doesn't email anyone until external is wired up.
      # Source: https://docs.fastlane.tools/actions/upload_to_testflight/
      notify_external_testers: false,
      expire_previous_builds: true
    )
  end

  # ──────────────────────────────────────────────────
  # Release — App Store
  # ──────────────────────────────────────────────────

  desc "Build, notarize, and submit to the App Store"
  lane :release do |options|
    test
    signing
    build
    notarize_app
    package

    api_key = get_api_key

    deliver(
      api_key: api_key,
      app_identifier: APP_IDENTIFIER,
      app_platform: "osx",
      team_id: TEAM_ID,

      metadata_path: "./metadata",
      screenshots_path: "./screenshots",

      pkg: PKG_FILE,
      skip_binary_upload: false,

      skip_metadata: false,
      skip_screenshots: false,
      overwrite_screenshots: true,

      app_rating_config_path: "./metadata/age_rating_config.json",

      primary_category: "DEVELOPER_TOOLS",
      secondary_category: "BUSINESS",

      submit_for_review: options[:submit] || false,
      automatic_release: options[:auto_release] || false,
      phased_release: true,
      force: true,

      app_review_information: {
        first_name: CONTACT_FIRST_NAME,
        last_name: CONTACT_LAST_NAME,
        phone_number: CONTACT_PHONE,
        email_address: APP_REVIEW_EMAIL,
        demo_user: "",
        demo_password: "",
        notes: review_notes
      },

      submission_information: {
        export_compliance_uses_encryption: false,
        add_id_info_uses_idfa: false
      }
    )
  end

  # ──────────────────────────────────────────────────
  # Promote — TestFlight → App Store
  # ──────────────────────────────────────────────────

  desc "Promote an existing TestFlight build to App Store review (no rebuild)"
  #
  # Invoked on tag push. The signed + notarized binary already lives
  # in TestFlight — uploaded by the `:beta` lane on merge to main —
  # so we reuse it via `deliver(skip_binary_upload: true)` rather
  # than rebuilding and re-uploading. This keeps the App Store bits
  # byte-identical to what beta testers validated.
  #
  # Usage:
  #   bundle exec fastlane promote version:1.2.3
  #   bundle exec fastlane promote version:1.2.3 build_number:47
  #   bundle exec fastlane promote version:1.2.3 auto_release:true
  #
  # If `build_number` is omitted, the latest TestFlight build for
  # the given version is used.
  lane :promote do |options|
    api_key = get_api_key

    version = options[:version] || ENV["APP_VERSION"]
    UI.user_error!("version: parameter or APP_VERSION env required (e.g., version:1.2.3)") if version.nil? || version.empty?

    build_number = options[:build_number] || latest_testflight_build_number(
      api_key: api_key,
      app_identifier: APP_IDENTIFIER,
      version: version,
      platform: "osx"
    )

    UI.message("Promoting TestFlight build #{build_number} (v#{version}) to App Store review")

    deliver(
      api_key: api_key,
      app_identifier: APP_IDENTIFIER,
      app_platform: "osx",
      team_id: TEAM_ID,

      # Point at the existing TestFlight binary — no re-upload.
      app_version: version.to_s,
      build_number: build_number.to_s,
      skip_binary_upload: true,

      # Refresh metadata + screenshots on every promotion so App
      # Store copy stays in sync with the repo. The `promote`
      # workflow runs `bundle exec fastlane ui_tests` immediately
      # before this action, which populates
      # `fastlane/screenshots/en-US/` from the XCUITest run, so
      # `overwrite_screenshots: true` is a full refresh every time
      # — never stale App Store artwork.
      skip_metadata: false,
      skip_screenshots: false,
      overwrite_screenshots: true,

      metadata_path: "./metadata",
      screenshots_path: "./screenshots",
      app_rating_config_path: "./metadata/age_rating_config.json",

      primary_category: "DEVELOPER_TOOLS",
      secondary_category: "BUSINESS",

      submit_for_review: true,
      automatic_release: options[:auto_release] || false,
      phased_release: true,
      force: true,

      app_review_information: {
        first_name: CONTACT_FIRST_NAME,
        last_name: CONTACT_LAST_NAME,
        phone_number: CONTACT_PHONE,
        email_address: APP_REVIEW_EMAIL,
        demo_user: "",
        demo_password: "",
        notes: review_notes
      },

      submission_information: {
        export_compliance_uses_encryption: false,
        add_id_info_uses_idfa: false
      }
    )

    UI.success("TestFlight build #{build_number} (v#{version}) submitted for App Store review")
  end

  # ──────────────────────────────────────────────────
  # Direct distribution — Developer ID, notarized, tagged,
  # published to GitHub Releases, and poured by Homebrew.
  #
  # This is the path for the website's Download button and for
  # `brew install --cask`. It is deliberately separate from the
  # App Store lanes: those sign with Apple Distribution, and
  # Apple does not accept that certificate for notarization.
  # ──────────────────────────────────────────────────

  desc "Sync the Developer ID Application certificate used for notarized builds"
  lane :signing_developer_id do
    # `type: "developer_id"` is what produces a "Developer ID
    # Application" certificate. Apple rejects Apple Distribution,
    # Apple Development and ad-hoc signatures at the notary
    # service, so the App Store `signing` lane cannot stand in
    # for this one.
    match(
      api_key: get_api_key,
      type: "developer_id",
      readonly: is_ci
    )
  end

  desc "Build, notarize, tag, publish to GitHub Releases, and update the Homebrew cask"
  #
  # Usage:
  #   bundle exec fastlane dist version:0.2.0
  #   bundle exec fastlane dist version:0.2.0 dry_run:true
  #
  # Runs locally today; the steps are ordered so the same lane
  # works unchanged in GitHub Actions once a runner image ships
  # the macOS 27 SDK.
  lane :dist do |options|
    version = (options[:version] || ENV["APP_VERSION"]).to_s
    unless version.match?(/\A\d+\.\d+\.\d+(-[0-9A-Za-z.-]+)?\z/)
      UI.user_error!("version: must be semver, e.g. version:0.2.0 (got #{version.inspect})")
    end
    dry_run = options[:dry_run] ? true : false
    tag = "v#{version}"
    zip_name = "Spooktacular-#{version}-macos-arm64.zip"
    zip_path = File.join(PROJECT_ROOT, zip_name)
    # The website links to a stable filename under /releases/latest/download/,
    # which only resolves if the asset name never changes. The cask needs the
    # opposite — an immutable, version-stamped URL to pin a sha256 against — so
    # the same bytes are published under both names.
    latest_name = "Spooktacular-macos-arm64.zip"
    latest_path = File.join(PROJECT_ROOT, latest_name)

    # ---- 1. Refuse to publish from a dirty or diverged tree ----
    Dir.chdir(PROJECT_ROOT) do
      unless sh("git status --porcelain", log: false).strip.empty?
        UI.user_error!("Working tree is dirty. Commit or stash before cutting a release.")
      end
      branch = sh("git rev-parse --abbrev-ref HEAD", log: false).strip
      UI.important("Releasing from '#{branch}' rather than main.") unless branch == "main"
      if sh("git tag --list #{tag}", log: false).strip == tag
        UI.user_error!("Tag #{tag} already exists. Bump the version or delete the tag.")
      end
      sh("git fetch origin --tags", log: false)
    end

    # ---- 2. Gates. A release is the wrong place to discover a red test ----
    test
    lint

    # ---- 3. Developer ID signing identity ----
    signing_developer_id
    identity = developer_id_identity
    UI.message("Signing with: #{identity}")

    # ---- 4. Build at the release version ----
    Dir.chdir(PROJECT_ROOT) do
      sh(
        { "CODESIGN_IDENTITY" => identity, "MARKETING_VERSION" => version },
        "./build-app.sh", "release"
      )
    end

    # ---- 5. Check the things the notary service checks, before uploading ----
    verify_notarization_prerequisites

    # ---- 6. Notarize and staple ----
    if dry_run
      UI.important("dry_run: skipping notarization, tag, release and cask update.")
    else
      notarize(
        package: APP_BUNDLE,
        bundle_id: APP_IDENTIFIER,
        api_key: get_api_key,
        verbose: true,
        print_log: true
      )
      # Apple staples to the .app; the ticket must be verified on the
      # bundle before it is zipped, because a zip cannot be stapled.
      sh("xcrun", "stapler", "validate", APP_BUNDLE)
      sh("spctl", "--assess", "--type", "exec", "--verbose=4", APP_BUNDLE)
      UI.success("Notarized and stapled.")
    end

    # ---- 7. Archive the stapled bundle ----
    FileUtils.rm_f(zip_path)
    Dir.chdir(PROJECT_ROOT) do
      # ditto preserves the signature and extended attributes that a
      # plain `zip` drops, which would otherwise break the signature.
      sh("ditto", "-c", "-k", "--sequesterRsrc", "--keepParent",
         "Spooktacular.app", zip_name)
    end
    FileUtils.cp(zip_path, latest_path)
    sha = Digest::SHA256.file(zip_path).hexdigest
    UI.success("#{zip_name}  sha256 #{sha}")

    if dry_run
      UI.success("dry_run complete. Artifact left at #{zip_path}")
      next
    end

    # ---- 8. Tag, then publish. Tag first so the release always has one ----
    Dir.chdir(PROJECT_ROOT) do
      sh("git", "tag", "-a", tag, "-m", "Spooktacular #{version}")
      sh("git", "push", "origin", tag)
    end

    notes = release_notes(version)
    Dir.chdir(PROJECT_ROOT) do
      sh("gh", "release", "create", tag, zip_path, latest_path,
         "--title", "Spooktacular #{version}",
         "--notes", notes,
         "--verify-tag")
    end
    UI.success("Published #{tag} with #{zip_name}")

    # ---- 9. Homebrew, in the same run, against the asset just published ----
    update_homebrew_cask(version: version, sha256: sha, asset: zip_name)

    UI.success([
      "Release #{version} is live.",
      "  Download page resolves to: https://github.com/#{GITHUB_REPO}/releases/latest/download/#{zip_name}",
      "  Homebrew: brew install --cask #{HOMEBREW_TAP}/spooktacular"
    ].join("\n"))
  end

  desc "Verify the .app satisfies Apple's notarization prerequisites"
  lane :verify_notarization_prerequisites do
    # Cheap local checks for the failures the notary service would
    # otherwise report 10 minutes later.
    out = sh("codesign", "--display", "--verbose=4", APP_BUNDLE, log: false) rescue ""
    entitlements = sh("codesign", "--display", "--entitlements", ":-", APP_BUNDLE, log: false) rescue ""

    unless out.include?("flags=") && out.match?(/runtime/)
      UI.user_error!("Hardened runtime missing. Apple requires it for notarization; build-app.sh should pass --options runtime.")
    end
    if out.include?("Timestamp=none")
      UI.user_error!("No secure timestamp. Apple requires one; codesign needs --timestamp (not --timestamp=none).")
    end
    if entitlements.match?(/get-task-allow.*\n?\s*<true/) || entitlements.include?("<key>com.apple.security.get-task-allow</key>\n\t<true/>")
      UI.user_error!("com.apple.security.get-task-allow is set true. Apple rejects notarization with it enabled.")
    end
    unless out.match?(/Authority=Developer ID Application/)
      UI.user_error!(
        "Not signed with a Developer ID Application certificate.\n" \
        "Apple will refuse notarization for Apple Distribution / Apple Development / ad-hoc signatures.\n" \
        "Create one in the developer portal, then run: bundle exec fastlane signing_developer_id"
      )
    end
    UI.success("Notarization prerequisites satisfied.")
  end

  # ──────────────────────────────────────────────────
  # UI Tests — XCUITest via `scan`, then extract screenshot
  # attachments from the .xcresult bundle.
  # ──────────────────────────────────────────────────

  desc "Run UI tests and extract XCTAttachment screenshots into fastlane/screenshots/en-US/"
  #
  # This lane works headlessly — no display required — because
  # XCUITest captures each screen via `XCTAttachment` inside the
  # test run (see Tests/SpooktacularUITests/ScreenshotTests.swift).
  # CI (GitHub Actions macos-26) and a developer's laptop follow
  # the same path, so screenshots produced on a PR look the same
  # as the ones a dev would commit locally.
  lane :ui_tests do
    # Regenerate the `.xcodeproj` from `project.yml` so the file
    # can't drift between what xcodegen would produce and what's
    # on disk. xcodegen is idempotent and cheap (sub-second) on a
    # cold run.
    Dir.chdir(PROJECT_ROOT) do
      sh("xcodegen", "generate")
    end

    # Screenshot generation runs XCUITests against a locally-run
    # macOS build — it never installs or distributes the app, so it
    # needs no real code-signing identity. We force signing OFF
    # (overriding project.yml's Manual/`match Development …` config)
    # so this lane is green on any machine and on CI WITHOUT the
    # `spooktacular-certificates` match repo being populated. Only
    # the signed `beta`/`release` lanes need match certs + the
    # App Store Connect API key. See docs/SIGNING.md.
    scan(
      project: "Spooktacular.xcodeproj",
      scheme: "SpooktacularApp",
      destination: "platform=macOS",
      only_testing: ["SpooktacularUITests"],
      result_bundle: true,
      output_directory: "./fastlane/test_output",
      output_types: "html,junit",
      xcargs: "CODE_SIGNING_ALLOWED=NO CODE_SIGNING_REQUIRED=NO " \
              "CODE_SIGN_IDENTITY='' PROVISIONING_PROFILE_SPECIFIER=''",
      fail_build: true
    )

    Dir.chdir(PROJECT_ROOT) do
      xcresult = Dir.glob("fastlane/test_output/*.xcresult").first
      UI.user_error!("no .xcresult bundle produced by scan") if xcresult.nil?
      sh("./scripts/extract-xcresult-screenshots.sh",
         xcresult,
         "./fastlane/screenshots/en-US")
    end
  end

  # ──────────────────────────────────────────────────
  # Screenshots — App Store artwork pipeline (local dev)
  # ──────────────────────────────────────────────────

  desc "Capture, process, and frame App Store screenshots (requires an interactive macOS session)"
  #
  # Local-dev counterpart to `:ui_tests`. Uses
  # `scripts/capture-screenshots.sh` (screencapture + osascript) to
  # produce un-framed App Store-sized PNGs, then runs frameit to
  # wrap them in device chrome for App Store submission.
  #
  # Skipped on CI because screencapture requires a display.
  # Reviewers should use the `ui_tests` lane output, which is
  # uploaded as a PR artifact.
  lane :screenshots do
    build

    Dir.chdir(PROJECT_ROOT) do
      sh("./scripts/capture-screenshots.sh")
      sh("./scripts/process-screenshots.sh")
    end

    frameit(
      path: "./fastlane/screenshots",
      white: false,
      force_orientation_block: proc { |_| :portrait }
    )

    UI.success("Screenshots captured, processed, and framed.")
  end

  # ──────────────────────────────────────────────────
  # Lint — SwiftLint + App Store metadata
  # ──────────────────────────────────────────────────

  desc "Run SwiftLint (strict) against Sources/ and Tests/"
  #
  # Thin wrapper around fastlane's built-in `swiftlint` action
  # (https://docs.fastlane.tools/actions/swiftlint) so CI and a
  # contributor's laptop share one entry point and the SwiftLint
  # version used is the one in Homebrew on the runner.
  #
  # No `config_file:` — SwiftLint auto-discovers
  # `.swiftlint.yml` at the repo root and the nested
  # `Tests/.swiftlint.yml` (which relaxes a handful of rules that
  # don't carry quality signal in test code). Passing
  # `config_file:` would disable that discovery per the SwiftLint
  # README.
  lane :lint do
    swiftlint(
      mode: :lint,
      strict: true,
      raise_if_swiftlint_error: true
    )
  end

  desc "Validate App Store metadata (description, release notes, keywords, …)"
  #
  # Runs before `:promote` so deliver doesn't reject the push on
  # a trailing whitespace or the word \"Android\". The underlying
  # `precheck` / `check_app_store_metadata` action hits App
  # Store Connect to pull current live metadata for the diff, so
  # it needs an authenticated API key — we feed it the same
  # ``get_api_key`` helper every publish lane uses.
  #
  # Gracefully skipped when the ASC API key is missing or
  # malformed (common symptom: "invalid curve name" from OpenSSL
  # when the `APPLE_API_KEY_P8` secret isn't correctly
  # base64-encoded). The release lanes will re-surface the same
  # credential error at publish time, so we don't silently paper
  # over it — just don't block the lint job on upstream
  # credential state.
  lane :lint_metadata do
    unless ENV["APPLE_API_KEY_ID"] && ENV["APPLE_API_ISSUER_ID"] && ENV["APPLE_API_KEY_P8"]
      UI.important("APPLE_API_* env vars unset — skipping App Store metadata precheck.")
      next
    end
    api_key = begin
      get_api_key
    rescue => e
      UI.important("App Store Connect API key is invalid (#{e.message}). " \
                   "Skipping metadata precheck; the release lane will re-raise " \
                   "this at publish time where it belongs.")
      next
    end
    check_app_store_metadata(
      api_key: api_key,
      default_rule_level: :error,
      negative_apple_sentiment: true,
      placeholder_text: true
    )
  end

  desc "Run Danger against the current pull request (PR hygiene + strict SwiftLint on changed files)"
  #
  # Named `pr_review` to avoid shadowing the built-in `danger`
  # action (fastlane refuses a lane whose name matches an
  # action's name). Wraps fastlane's `danger` action — which
  # auto-uses `bundle exec` when a Gemfile is present — with the
  # Dangerfile at the repo root and the danger-swiftlint gem.
  #
  # Invoked from `.github/workflows/ci.yml` only on
  # pull_request events so the strict force-unwrap rule runs on
  # the contributor's diff and never on push-to-main (which has
  # no PR context for Danger to read).
  lane :pr_review do
    danger(
      github_api_token: ENV["GITHUB_TOKEN"] || ENV["DANGER_GITHUB_API_TOKEN"],
      fail_on_errors: true,
      new_comment: false,
      remove_previous_comments: true
    )
  end

  # ──────────────────────────────────────────────────
  # Setup — Register app ID
  # ──────────────────────────────────────────────────

  desc "Register app identifier in Apple Developer Portal"
  # Registers every bundle identifier the project needs on the
  # Apple Developer Portal — idempotent, API-key-authed,
  # zero-2FA-prompt.
  #
  # Why not `produce`? The built-in `produce` / `create_app_online`
  # action only accepts `username` for auth (legacy Apple-ID +
  # 2FA), which is exactly what the API-key flow exists to avoid.
  # Our custom `register_bundle_id` action (in
  # `fastlane/actions/`) wraps `Spaceship::ConnectAPI::BundleId`
  # — the same Spaceship gem bundler already pins through
  # fastlane — with the ASC-API token path, so registration
  # runs headless everywhere.
  #
  # The App Store Connect app record (the `produce` output for
  # TestFlight + App Store submission) is deferred until the
  # first `beta` / `release` lane run, which uses `pilot` /
  # `deliver` — both of those accept API keys and create the
  # record on demand.
  lane :register_app do
    # `app_store_connect_api_key` (wrapped by `get_api_key`)
    # defaults `set_spaceship_token: true`, so a single call
    # authorizes every subsequent `Spaceship::ConnectAPI` request
    # in this lane — including the ones our
    # `register_bundle_id` action makes. No need to pass the
    # key explicitly.
    get_api_key

    register_bundle_id(
      identifier: APP_IDENTIFIER,
      name: "Spooktacular",
      capabilities: []
    )
  end

  # ──────────────────────────────────────────────────
  # Helpers
  # ──────────────────────────────────────────────────

  # Resolves an App Store Connect API key (.p8) in the form
  # `app_store_connect_api_key` + the underlying `spaceship`
  # token can actually parse.
  #
  # Why this is not a one-line call to `app_store_connect_api_key`:
  #
  # The canonical pattern (key_content: ENV["APPLE_API_KEY_P8"],
  # is_key_content_base64: true) is broken on GitHub Actions —
  # see fastlane/fastlane#29478. The secret's base64 payload
  # survives intact through the `env:` block, but OpenSSL fails
  # to parse it back into a P-256 EC key, producing
  # "OpenSSL::PKey::ECError: invalid curve name" right at the
  # JWT-signing moment. The workaround that the thread
  # consistently lands on (and that we adopt here) is to
  # write the decoded .p8 to disk ourselves and hand fastlane
  # a `key_filepath:` — which goes through a completely
  # different `OpenSSL::PKey.read` path that *does* work.
  #
  # Callers keep their environment variable layout unchanged:
  # APPLE_API_KEY_ID, APPLE_API_ISSUER_ID, and a base64-encoded
  # APPLE_API_KEY_P8 (produced by
  # `cat AuthKey_XXXXXXXXXX.p8 | openssl base64 -A`). The
  # .p8 we write to disk is owner-only (mode 0600), lives under
  # `fastlane/ci/AuthKey.p8` inside the repo's work tree so a
  # single-run CI job's cleanup step can `rm -rf fastlane/ci`
  # without thinking about paths, and is never committed
  # (`.gitignore` excludes the directory).
  private_lane :get_api_key do
    filepath = ensure_api_key_on_disk
    app_store_connect_api_key(
      key_id: ENV["APPLE_API_KEY_ID"],
      issuer_id: ENV["APPLE_API_ISSUER_ID"],
      key_filepath: filepath,
      in_house: false
    )
  end

  # Decodes APPLE_API_KEY_P8 (base64) → `fastlane/ci/AuthKey.p8`
  # exactly once per fastlane run. Returns the absolute path.
  # Idempotent: re-running is a no-op that returns the same
  # path. The caller (``get_api_key``) is responsible for
  # feeding the path to the action; this lane does not call
  # `app_store_connect_api_key` so it's safe to invoke from
  # anywhere without starting a spaceship session.
  private_lane :ensure_api_key_on_disk do
    UI.user_error!("APPLE_API_KEY_ID is unset") if (ENV["APPLE_API_KEY_ID"] || "").empty?
    UI.user_error!("APPLE_API_ISSUER_ID is unset") if (ENV["APPLE_API_ISSUER_ID"] || "").empty?

    if ENV["APPLE_API_KEY_FILEPATH"] && File.exist?(ENV["APPLE_API_KEY_FILEPATH"])
      next ENV["APPLE_API_KEY_FILEPATH"]
    end
    UI.user_error!("APPLE_API_KEY_P8 is unset") if (ENV["APPLE_API_KEY_P8"] || "").empty?

    require 'base64'
    dir = File.expand_path("./fastlane/ci", PROJECT_ROOT)
    path = File.join(dir, "AuthKey.p8")

    FileUtils.mkdir_p(dir)
    raw = ENV["APPLE_API_KEY_P8"]
    # `strict_decode64` would reject base64 that contains
    # newlines — which some CI systems introduce when the
    # secret was encoded without `openssl base64 -A`. Use
    # the lenient `decode64` so both single-line and
    # multi-line base64 inputs produce the same .p8 bytes.
    pem = Base64.decode64(raw)

    unless pem.include?("BEGIN PRIVATE KEY") || pem.include?("BEGIN EC PRIVATE KEY")
      UI.user_error!(
        "APPLE_API_KEY_P8 did not decode to a PEM-formatted .p8 key. " \
        "Re-encode with `cat AuthKey_XXXXXXXXXX.p8 | openssl base64 -A` " \
        "and update the secret."
      )
    end

    File.write(path, pem)
    File.chmod(0o600, path)
    ENV["APPLE_API_KEY_FILEPATH"] = path
    UI.message("Wrote App Store Connect API key → #{path} (mode 0600)")
    path
  end

  # Shared text — defined once, used everywhere.

  def self.app_description
    "macOS Virtualization for Teams on Apple Silicon. " \
    "Run 2 macOS VMs per Mac — the maximum Apple's EULA allows. " \
    "Build iOS apps, sign code, run CI pipelines, host remote desktops, " \
    "and deploy computer-using AI agents."
  end

  def self.review_notes
    "Spooktacular uses Apple's Virtualization.framework " \
    "(com.apple.security.virtualization entitlement) to create and manage " \
    "macOS VMs on Apple Silicon. Works only on Apple Silicon Macs. " \
    "The app includes a GUI, a bundled CLI (spook), and an HTTP API server. " \
    "No account or internet connection required — all VMs run locally."
  end

  # Resolve the Developer ID Application identity from the keychain rather
  # than interpolating a name. Notarization fails on any other certificate
  # type, so this is worth reading back instead of assuming.
  def self.developer_id_identity
    out = `security find-identity -v -p codesigning 2>/dev/null`
    match = out.lines.grep(/Developer ID Application/).first
    if match.nil?
      UI.user_error!(
        "No 'Developer ID Application' certificate in the keychain.\n" \
        "Apple requires it for notarized distribution outside the App Store, and will not\n" \
        "accept the Apple Distribution certificate this project uses for the App Store.\n" \
        "\n" \
        "One-time setup:\n" \
        "  1. Create a Developer ID Application certificate for team #{TEAM_ID}.\n" \
        "  2. bundle exec fastlane signing_developer_id\n"
      )
    end
    match[/"([^"]+)"/, 1]
  end

  # Notes for the GitHub Release. Prefers a hand-written section in
  # CHANGELOG.md so a release can say something specific; falls back to a
  # short, honest template rather than inventing highlights.
  def self.release_notes(version)
    changelog = File.join(PROJECT_ROOT, "CHANGELOG.md")
    if File.exist?(changelog)
      body = File.read(changelog)
      section = body[/^##+\s*\[?#{Regexp.escape(version)}\]?.*?\n(.*?)(?=\n##+\s|\z)/m, 1]
      return section.strip unless section.nil? || section.strip.empty?
    end
    [
      "Spooktacular #{version} for Apple silicon.",
      "",
      "Requires macOS 27 or later for macOS guests. Linux guests run on earlier hosts.",
      "",
      "This build is signed with a Developer ID certificate and notarized by Apple,",
      "so it opens without a Gatekeeper override.",
      "",
      "Install with Homebrew:",
      "",
      "    brew install --cask #{HOMEBREW_TAP}/spooktacular",
      "",
      "Or download the archive below, unzip it, and move Spooktacular.app to /Applications.",
      "",
      "Full commit history: https://github.com/#{GITHUB_REPO}/commits/v#{version}"
    ].join("\n")
  end

  # Rewrite the cask in-repo, then push it to the tap. The tap holds a copy
  # because Homebrew reads casks from the tap, but the repo keeps the source
  # of truth so a release is reviewable in one diff.
  def self.update_homebrew_cask(version:, sha256:, asset:)
    url = "https://github.com/#{GITHUB_REPO}/releases/download/v#{version}/#{asset}"
    FileUtils.mkdir_p(File.dirname(CASK_FILE))
    File.write(CASK_FILE, <<~RUBY)
      # Generated by `fastlane dist`. Edit the lane, not this file.
      cask "spooktacular" do
        version "#{version}"
        sha256 "#{sha256}"

        url "https://github.com/#{GITHUB_REPO}/releases/download/v\#{version}/Spooktacular-\#{version}-macos-arm64.zip"
        name "Spooktacular"
        desc "Create macOS virtual machines in seconds from a shared base image"
        homepage "https://spooktacular.app/"

        # A bare symbol is already a minimum ("this release or newer"), which
        # is what brew style enforces. The real floor is macOS 27, but
        # Homebrew rejects numeric versions here and there is no verified
        # symbol for 27 yet, so this sits one release low on purpose: an
        # unknown symbol would break the cask outright, whereas this only lets
        # a macOS 26 user install and read the caveat. Tighten it when the
        # symbol lands.
        depends_on macos: :tahoe
        depends_on arch: :arm64

        app "Spooktacular.app"
        binary "#{'#'}{appdir}/Spooktacular.app/Contents/MacOS/spook"

        zap trash: [
          "~/Library/Application Support/com.spooktacular.app",
          "~/Library/Caches/com.spooktacular.app",
          "~/Library/Preferences/com.spooktacular.app.plist",
          "~/Library/Saved Application State/com.spooktacular.app.savedState",
        ]

        caveats <<~EOS
          Creating macOS virtual machines requires macOS 27 or later, because
          the shared base image and its copy-on-write overlays are built on
          DiskImageKit. On macOS 26 the app installs and runs, and Linux guests
          work, but macOS guests will refuse to be created.

          Spooktacular keeps virtual machines and cached base images in
          ~/.spooktacular. Deleting the app does not remove them; `brew uninstall
          --zap` does not either, because losing a VM to an uninstall would be
          worse than leaving the directory behind.

          The first macOS VM you create installs macOS into a shared base image.
          That takes 10-20 minutes and asks for an administrator password once.
          Every VM created afterwards takes seconds and needs no privileges.
        EOS
      end
    RUBY
    UI.success("Cask written: #{CASK_FILE}")

    # `brew style` accepts a path; `brew audit` requires a tapped name, so the
    # audit runs after the tap is updated, below.
    begin
      sh("brew", "style", CASK_FILE)
    rescue StandardError => e
      UI.user_error!("brew style rejected the generated cask: #{e.message}")
    end

    Dir.chdir(PROJECT_ROOT) do
      sh("git", "add", CASK_FILE)
      sh("git", "commit", "-m", "chore(release): cask #{version}")
      sh("git", "push", "origin", "HEAD")
    end

    tap_repo = "https://github.com/#{HOMEBREW_TAP.sub('/', '/homebrew-')}.git"
    Dir.mktmpdir do |dir|
      begin
        sh("git", "clone", "--depth", "1", tap_repo, dir)
      rescue StandardError
        UI.important(
          "Could not clone the tap at #{tap_repo}.\n" \
          "Create it (a repo named homebrew-tap under the #{HOMEBREW_TAP.split('/').first} org),\n" \
          "then re-run: bundle exec fastlane dist version:#{version}\n" \
          "The release and its asset are already published; only the tap is behind."
        )
        next
      end
      # Casks must sit in a top-level `Casks` directory of the tap, and
      # Homebrew recommends the tap carry a README.
      FileUtils.mkdir_p(File.join(dir, "Casks"))
      FileUtils.cp(CASK_FILE, File.join(dir, "Casks", "spooktacular.rb"))
      File.write(File.join(dir, "README.md"), <<~MD)
        # #{HOMEBREW_TAP.split("/").first} Homebrew tap

        Casks for [Spooktacular](https://spooktacular.app/), which creates macOS
        virtual machines in seconds from a shared, read-only base image.

        ## Install

        ```sh
        brew tap #{HOMEBREW_TAP}
        brew install --cask spooktacular
        ```

        Or in one step, without tapping first:

        ```sh
        brew install --cask #{HOMEBREW_TAP}/spooktacular
        ```

        ## Requirements

        - Apple silicon. Intel Macs cannot run macOS guests.
        - macOS 27 or later for macOS guests; Linux guests run on earlier hosts.

        Builds are signed with a Developer ID certificate and notarized by
        Apple, so they open without a Gatekeeper override.

        ## Updating

        This tap is written by `fastlane dist` in the
        [Spooktacular repository](https://github.com/#{GITHUB_REPO}); the cask
        there is the source of truth. Send changes to that repository rather
        than editing this one, or they will be overwritten by the next release.
      MD
      Dir.chdir(dir) do
        sh("git", "add", "Casks/spooktacular.rb")
        sh("git", "commit", "-m", "spooktacular #{version}")
        sh("git", "push")
      end
      UI.success("Tap updated: brew install --cask #{HOMEBREW_TAP}/spooktacular")
    end

    # Audit against the published asset. Non-fatal: the release is already out,
    # and an audit warning is worth seeing rather than worth failing over.
    begin
      sh("brew", "tap", HOMEBREW_TAP)
      sh("brew", "audit", "--cask", "--online", "#{HOMEBREW_TAP}/spooktacular")
      UI.success("brew audit clean.")
    rescue StandardError => e
      UI.important("brew audit reported issues (release is published; fix in the next bump): #{e.message}")
    end
  end

  def self.default_changelog
    "v1.0.1 — GUI ↔ CLI feature parity.\n" \
    "\n" \
    "• SSH into workspaces with one tap (toolbar split-button also copies the IP).\n" \
    "• Install from a local IPSW file — skip the 10–20 GB Apple download.\n" \
    "• First-boot templates in Create: GitHub Actions runner, OpenClaw agent, Screen Sharing (VNC).\n" \
    "• Clone VMs from the sidebar with a proper name dialog (⌘D).\n" \
    "• Add, remove, and toggle read-only on shared folders in the Hardware editor.\n" \
    "\n" \
    "What to test: the five flows above, end-to-end. File feedback from Help > Send Feedback."
  end

  after_all do |lane|
    UI.success("Lane '#{lane}' completed successfully.")
  end

  error do |lane, exception|
    UI.error("Lane '#{lane}' failed: #{exception.message}")
  end
end
