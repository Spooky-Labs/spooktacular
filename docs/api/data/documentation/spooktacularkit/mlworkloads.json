ktacularKit/documentation/SpooktacularKit/OpenClawGuide":{"kind":"article","identifier":"doc:\/\/spooktacular.SpooktacularKit\/documentation\/SpooktacularKit\/OpenClawGuide","abstract":[{"type":"text","text":"Run two isolated OpenClaw AI agent instances on a single Mac — each with its own workspace, channels, and API keys."}],"role":"collectionGroup","title":"Running OpenClaw in Virtual Machines","url":"\/documentation\/spooktacularkit\/openclawguide","type":"topic"},"doc://spooktacular.SpooktacularKit/documentation/SpooktacularKit/InstantCreate":{"type":"topic","url":"\/documentation\/spooktacularkit\/instantcreate","kind":"article","title":"Instant macOS VM Creation","role":"collectionGroup","abstract":[{"type":"text","text":"How Spooktacular creates macOS VMs in seconds without root, by installing"},{"text":" ","type":"text"},{"text":"macOS once into a shared base image and giving every VM its own","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"copy-on-write overlay."}],"identifier":"doc:\/\/spooktacular.SpooktacularKit\/documentation\/SpooktacularKit\/InstantCreate"}}}