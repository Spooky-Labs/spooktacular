y .xz-compressed):","spook create dev-box --os linux --from-image ~\/images\/custom.raw.xz"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Ubuntu publishes qcow2-only cloud images; convert first"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":"qemu-img convert -O raw src.img dst.raw"},{"type":"text","text":"). The "},{"type":"codeVoice","code":"--installer-iso"},{"type":"text","text":" flow"},{"type":"text","text":" "},{"type":"text","text":"remains for manual, unprovisioned installs and provisions nothing."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Downloads cache under "},{"type":"codeVoice","code":"~\/.spooktacular\/cache\/images\/"},{"type":"text","text":". The image is"},{"type":"text","text":" "},{"type":"text","text":"materialized as the VM’s disk and grown to "},{"type":"codeVoice","code":"--disk"},{"type":"text","text":" GiB; cloud-init’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"growpart"},{"type":"text","text":" expands the root filesystem on first boot."}],"type":"paragraph"},{"level":2,"text":"The account and the seed lifecycle","type":"heading","anchor":"The-account-and-the-seed-lifecycle"},{"inlineContent":[{"type":"codeVoice","code":"--vm-user"},{"type":"text","text":" (default "},{"type":"codeVoice","code":"admin"},{"type":"text","text":") and "},{"type":"codeVoice","code":"--vm-password"},{"type":"text","text":" (generated and shown"},{"type":"text","text":" "},{"type":"text","text":"once when omitted) define the guest account. The password enters the seed"},{"type":"text","text":" "},{"type":"strong","inlineContent":[{"type":"text","text":"only as a SHA-512-crypt hash"}]},{"type":"text","text":" — the "},{"type":"codeVoice","code":"\/etc\/shadow"},{"type":"text","text":" posture; plaintext"},{"type":"text","text":" "},{"type":"text","text":"never touches the host disk. Readable public keys from "},{"type":"codeVoice","code":"~\/.ssh"},{"type":"text","text":" are added"},{"type":"text","text":" "},{"type":"text","text":"to "},{"type":"codeVoice","code":"ssh_authorized_keys"},{"type":"text","text":", and "},{"type":"codeVoice","code":"ssh_pwauth: true"},{"type":"text","text":" enables password SSH."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"At create, Spooktacular renders "},{"type":"codeVoice","code":"user-data"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"meta-data"},{"type":"text","text":", packages them"},{"type":"text","text":" "},{"type":"text","text":"with "},{"type":"codeVoice","code":"hdiutil makehybrid"},{"type":"text","text":" into a "},{"type":"codeVoice","code":"cidata"},{"type":"text","text":"-labeled "},{"type":"codeVoice","code":"seed.iso"},{"type":"text","text":" in the"},{"type":"text","text":" "},{"type":"text","text":"bundle, and records a non-secret "},{"type":"reference","identifier":"doc:\/\/spooktacular.SpooktacularKit\/documentation\/SpooktacularKit\/PendingProvisioning","isActive":true},{"type":"text","text":" marker in"},{"type":"text","text":" "},{"type":"codeVoice","code":"metadata.json"},{"type":"text","text":". The first "},{"type":"codeVoice","code":"spook start"},{"type":"text","text":" (or app start) boots plainly —"},{"type":"text","text":" "},{"type":"text","text":"cloud-init does all the work in-guest — then "},{"type":"strong","inlineContent":[{"type":"text","text":"erases the seed and clears"},{"type":"text","text":" "},{"type":"text","text":"the marker"}]},{"type":"text","text":", so the hash doesn’t outlive provisioning."}],"type":"paragraph"},{"level":2,"text":"Templates","type":"heading","anchor":"Templates"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"OpenClaw","type":"text"}]},{"type":"text","text":" ("},{"type":"codeVoice","code":"--openclaw"},{"type":"text","text":"): Node 24 (newest 24.x from nodejs.org at"},{"type":"text","text":" "},{"type":"text","text":"script runtime) into "},{"type