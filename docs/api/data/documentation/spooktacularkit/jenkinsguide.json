{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/spooktacular.SpooktacularKit\/documentation\/SpooktacularKit\/JenkinsGuide"},"hierarchy":{"paths":[["doc:\/\/spooktacular.SpooktacularKit\/documentation\/SpooktacularKit"]]},"metadata":{"title":"Configuring Jenkins Nodes","modules":[{"name":"SpooktacularKit"}],"roleHeading":"API Collection","role":"collectionGroup"},"schemaVersion":{"minor":3,"patch":0,"major":0},"sections":[],"topicSections":[{"anchor":"Related-Guides","title":"Related Guides","identifiers":["doc:\/\/spooktacular.SpooktacularKit\/documentation\/SpooktacularKit\/GettingStarted","doc:\/\/spooktacular.SpooktacularKit\/documentation\/SpooktacularKit\/CLIReference"]},{"anchor":"Key-Types","title":"Key Types","identifiers":["doc:\/\/spooktacular.SpooktacularKit\/documentation\/SpooktacularKit\/VirtualMachineSpecification","doc:\/\/spooktacular.SpooktacularKit\/documentation\/SpooktacularKit\/ProvisioningMode","doc:\/\/spooktacular.SpooktacularKit\/documentation\/SpooktacularKit\/SSHExecutor"]}],"abstract":[{"type":"text","text":"Run Jenkins build agents in Spooktacular VMs for iOS and macOS CI\/CD."}],"variants":[{"paths":["\/documentation\/spooktacularkit\/jenkinsguide"],"traits":[{"interfaceLanguage":"swift"}]}],"seeAlsoSections":[{"generated":true,"anchor":"Guides","title":"Guides","identifiers":["doc:\/\/spooktacular.SpooktacularKit\/documentation\/SpooktacularKit\/GettingStarted","doc:\/\/spooktacular.SpooktacularKit\/documentation\/SpooktacularKit\/InstantCreate","doc:\/\/spooktacular.SpooktacularKit\/documentation\/SpooktacularKit\/Provisioning","doc:\/\/spooktacular.SpooktacularKit\/documentation\/SpooktacularKit\/LinuxProvisioning","doc:\/\/spooktacular.SpooktacularKit\/documentation\/SpooktacularKit\/CLIReference","doc:\/\/spooktacular.SpooktacularKit\/documentation\/SpooktacularKit\/GitHubActionsGuide","doc:\/\/spooktacular.SpooktacularKit\/documentation\/SpooktacularKit\/EC2MacDeployment","doc:\/\/spooktacular.SpooktacularKit\/documentation\/SpooktacularKit\/MLWorkloads","doc:\/\/spooktacular.SpooktacularKit\/documentation\/SpooktacularKit\/RemoteDesktop","doc:\/\/spooktacular.SpooktacularKit\/documentation\/SpooktacularKit\/OpenClawGuide","doc:\/\/spooktacular.SpooktacularKit\/documentation\/SpooktacularKit\/BlueBubblesGuide","doc:\/\/spooktacular.SpooktacularKit\/documentation\/SpooktacularKit\/Versioning"]}],"primaryContentSections":[{"kind":"content","content":[{"type":"heading","anchor":"Overview","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Jenkins can use Spooktacular VMs as build agents. Each Mac runs"},{"type":"text","text":" "},{"type":"text","text":"2 VMs, each VM runs a Jenkins agent — doubling your Mac CI capacity."}]},{"anchor":"Prerequisites","type":"heading","text":"Prerequisites","level":2},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Apple Silicon Mac with Spooktacular installed","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Jenkins controller (runs on any OS)"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"SSH connectivity between Jenkins controller and Mac host"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A base VM with Xcode and the Jenkins agent installed"}]}]}]},{"anchor":"Creating-a-Base-Image","text":"Creating a Base Image","level":2,"type":"heading"},{"code":["# Create the base VM","spook create jenkins-base --from-ipsw latest","","# Install Xcode and Jenkins agent in the base VM","# (Use SSH after the VM boots, or disk-inject provisioning)","spook start jenkins-base","spook ssh jenkins-base","","# Inside the VM:","# 1. Install Xcode from the App Store or xcode-select","# 2. Download the Jenkins agent .jar from your Jenkins controller","# 3. Create a LaunchAgent to start the agent on boot"],"syntax":"bash","type":"codeListing"},{"anchor":"Provisioning-Script","text":"Provisioning Script","level":2,"type":"heading"},{"type":"paragraph","inlineContent":[{"text":"Create a provisioning script that registers the VM as a Jenkins agent:","type":"text"}]},{"syntax":"bash","code":["#!\/bin\/bash","# jenkins-agent-setup.sh","","JENKINS_URL=\"https:\/\/jenkins.example.com\"","AGENT_NAME=\"$(hostname)\"","AGENT_SECRET=\"YOUR_AGENT_SECRET\"","","# Download the agent .jar","curl -sO \"$JENKINS_URL\/jnlpJars\/agent.jar\"","","# Start the agent","java -jar agent.jar \\","  -url \"$JENKINS_URL\" \\","  -secret \"$AGENT_SECRET\" \\","  -name \"$AGENT_NAME\" \\","  -workDir \"\/Users\/admin\/jenkins\""],"type":"codeListing"},{"level":2,"text":"Clone and Start Agents","type":"heading","anchor":"Clone-and-Start-Agents"},{"syntax":"bash","code":["# Clone the base image for each agent","spook clone jenkins-base jenkins-agent-01","spook clone jenkins-base jenkins-agent-02","","# Start with the provisioning script","spook start jenkins-agent-01 --headless \\","  --user-data .\/jenkins-agent-setup.sh --provision ssh","","spook start jenkins-agent-02 --headless \\","  --user-data .\/jenkins-agent-setup.sh --provision ssh"],"type":"codeListing"},{"level":2,"text":"Ephemeral Agents","type":"heading","anchor":"Ephemeral-Agents"},{"inlineContent":[{"text":"For clean builds every time, use ephemeral mode. The VM is","type":"text"},{"type":"text","text":" "},{"type":"text","text":"destroyed after the agent disconnects:"}],"type":"paragraph"},{"type":"codeListing","syntax":"bash","code":["spook start jenkins-agent-01 --headless --ephemeral \\","  --user-data .\/jenkins-agent-setup.sh --provision ssh"]},{"inlineContent":[{"type":"text","text":"Combine with a cron job or Jenkins pipeline that re-clones"},{"text":" ","type":"text"},{"type":"text","text":"and re-starts agents between builds."}],"type":"paragraph"},{"level":2,"text":"Running as a Service","type":"heading","anchor":"Running-as-a-Service"},{"inlineContent":[{"text":"For persistent agents that survive Mac reboots:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"bash","code":["sudo spook service install jenkins-agent-01","sudo spook service install jenkins-agent-02"]}]}],"kind":"article","references":{"doc://spooktacular.SpooktacularKit/documentation/SpooktacularKit/Provisioning":{"kind":"article","identifier":"doc:\/\/spooktacular.SpooktacularKit\/documentation\/SpooktacularKit\/Provisioning","abstract":[{"type":"text","text":"Run scripts automatically when a VM boots."}],"role":"collectionGroup","title":"Provisioning Virtual Machines","url":"\/documentation\/spooktacularkit\/provisioning","type":"topic"},"doc://spooktacular.SpooktacularKit/documentation/SpooktacularKit/Versioning":{"type":"topic","url":"\/documentation\/spooktacularkit\/versioning","kind":"article","title":"Versioning & Release Schedule","role":"collectionGroup","abstract":[{"text":"Understand what version numbers mean and what to expect from each release.","type":"text"}],"identifier":"doc:\/\/spooktacular.SpooktacularKit\/documentation\/SpooktacularKit\/Versioning"},"doc://spooktacular.SpooktacularKit/documentation/SpooktacularKit/GettingStarted":{"kind":"article","identifier":"doc:\/\/spooktacular.SpooktacularKit\/documentation\/SpooktacularKit\/GettingStarted","abstract":[{"type":"text","text":"Create your first macOS virtual machine in minutes."}],"role":"collectionGroup","title":"Getting Started with Spooktacular","url":"\/documentation\/spooktacularkit\/gettingstarted","type":"topic"},"doc://spooktacular.SpooktacularKit/documentation/SpooktacularKit/InstantCreate":{"type":"topic","url":"\/documentation\/spooktacularkit\/instantcreate","kind":"article","title":"Instant macOS VM Creation","role":"collectionGroup","abstract":[{"type":"text","text":"How Spooktacular creates macOS VMs in seconds without root, by installing"},{"text":" ","type":"text"},{"text":"macOS once into a shared base image and giving every VM its own","type":"text"},{"text":" ","type":"text"},{"type":"text","t