cularkit\/vmnetnetwork","navigatorTitle":[{"kind":"identifier","text":"VmnetNetwork"}],"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"VmnetNetwork"}],"role":"symbol","type":"topic","kind":"symbol","abstract":[]},"doc://spooktacular.SpooktacularKit/documentation/SpooktacularKit/ProvisioningSignal":{"type":"topic","url":"\/documentation\/spooktacularkit\/provisioningsignal","kind":"symbol","title":"ProvisioningSignal","role":"symbol","abstract":[],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ProvisioningSignal"}],"navigatorTitle":[{"kind":"identifier","text":"ProvisioningSignal"}],"identifier":"doc:\/\/spooktacular.SpooktacularKit\/documentation\/SpooktacularKit\/ProvisioningSignal"},"doc://spooktacular.SpooktacularKit/documentation/SpooktacularKit/BlueBubblesGuide":{"type":"topic","url":"\/documentation\/spooktacularkit\/bluebubblesguide","kind":"article","title":"Running BlueBubbles iMessage Server","role":"collectionGroup","abstract":[{"text":"Set up a BlueBubbles iMessage server in a macOS VM — a dramatically simpler alternative to VMware on Windows.","type":"text"}],"identifier":"doc:\/\/spooktacular.SpooktacularKit\/documentation\/SpooktacularKit\/BlueBubblesGuide"},"doc://spooktacular.SpooktacularKit/documentation/SpooktacularKit/GitHubActionsGuide":{"kind":"article","identifier":"doc:\/\/spooktacular.SpooktacularKit\/documentation\/SpooktacularKit\/GitHubActionsGuide","abstract":[{"text":"Run self-hosted macOS GitHub Actions runners in Spooktacular VMs with ephemeral isolation and automatic scaling.","type":"text"}],"role":"collectionGroup","title":"Configuring GitHub Actions Runners","url":"\/documentation\/spooktacularkit\/githubactionsguide","type":"topic"},"doc://spooktacular.SpooktacularKit/documentation/SpooktacularKit/BaseImageStore":{"identifier":"doc:\/\/spooktacular.SpooktacularKit\/documentation\/SpooktacularKit\/BaseImageStore","kind":"symbol","role":"symbol","url":"\/documentation\/spooktacularkit\/baseimagestore","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"BaseImageStore","kind":"identifier"}],"type":"topic","navigatorTitle":[{"kind":"identifier","text":"BaseImageStore"}],"title":"BaseImageStore","abstract":[]},"doc://spooktacular.SpooktacularKit/documentation/SpooktacularKit/RemoteDesktop":{"identifier":"doc:\/\/spooktacular.SpooktacularKit\/documentation\/SpooktacularKit\/RemoteDesktop","role":"collectionGroup","abstract":[{"text":"Connect to Spooktacular VMs via VNC for remote development, QA testing, and design review.","type":"text"}],"url":"\/documentation\/spooktacularkit\/remotedesktop","title":"Remote Desktop Access","type":"topic","kind":"article"}}}