{"identifier":{"url":"doc:\/\/spooktacular.SpooktacularKit\/documentation\/SpooktacularKit\/InstantCreate","interfaceLanguage":"swift"},"kind":"article","hierarchy":{"paths":[["doc:\/\/spooktacular.SpooktacularKit\/documentation\/SpooktacularKit"]]},"seeAlsoSections":[{"title":"Guides","identifiers":["doc:\/\/spooktacular.SpooktacularKit\/documentation\/SpooktacularKit\/GettingStarted","doc:\/\/spooktacular.SpooktacularKit\/documentation\/SpooktacularKit\/Provisioning","doc:\/\/spooktacular.SpooktacularKit\/documentation\/SpooktacularKit\/LinuxProvisioning","doc:\/\/spooktacular.SpooktacularKit\/documentation\/SpooktacularKit\/CLIReference","doc:\/\/spooktacular.SpooktacularKit\/documentation\/SpooktacularKit\/GitHubActionsGuide","doc:\/\/spooktacular.SpooktacularKit\/documentation\/SpooktacularKit\/JenkinsGuide","doc:\/\/spooktacular.SpooktacularKit\/documentation\/SpooktacularKit\/EC2MacDeployment","doc:\/\/spooktacular.SpooktacularKit\/documentation\/SpooktacularKit\/MLWorkloads","doc:\/\/spooktacular.SpooktacularKit\/documentation\/SpooktacularKit\/RemoteDesktop","doc:\/\/spooktacular.SpooktacularKit\/documentation\/SpooktacularKit\/OpenClawGuide","doc:\/\/spooktacular.SpooktacularKit\/documentation\/SpooktacularKit\/BlueBubblesGuide","doc:\/\/spooktacular.SpooktacularKit\/documentation\/SpooktacularKit\/Versioning"],"generated":true,"anchor":"Guides"}],"sections":[],"topicSections":[{"title":"Base images","identifiers":["doc:\/\/spooktacular.SpooktacularKit\/documentation\/SpooktacularKit\/BaseImageStore","doc:\/\/spooktacular.SpooktacularKit\/documentation\/SpooktacularKit\/BaseImageDescriptor","doc:\/\/spooktacular.SpooktacularKit\/documentation\/SpooktacularKit\/BaseImageBuilder"],"anchor":"Base-images"},{"anchor":"Disks","identifiers":["doc:\/\/spooktacular.SpooktacularKit\/documentation\/SpooktacularKit\/DiskStack"],"title":"Disks"},{"title":"Networking","identifiers":["doc:\/\/spooktacular.SpooktacularKit\/documentation\/SpooktacularKit\/VmnetNetwork","doc:\/\/spooktacular.SpooktacularKit\/documentation\/SpooktacularKit\/GuestNetworkAllocation","doc:\/\/spooktacular.SpooktacularKit\/documentation\/SpooktacularKit\/PortPublication"],"anchor":"Networking"},{"title":"Readiness","identifiers":["doc:\/\/spooktacular.SpooktacularKit\/documentation\/SpooktacularKit\/ProvisioningSignal","doc:\/\/spooktacular.SpooktacularKit\/documentation\/SpooktacularKit\/ProvisioningSignalListener"],"anchor":"Readiness"}],"schemaVersion":{"major":0,"minor":3,"patch":0},"primaryContentSections":[{"content":[{"level":2,"text":"Overview","anchor":"Overview","type":"heading"},{"inlineContent":[{"type":"text","text":"Installing macOS takes 10–20 minutes and writing a provisioner into a guest"},{"text":" ","type":"text"},{"type":"text","text":"disk needs root. Doing both per VM makes every create slow and privileged."},{"type":"text","text":" "},{"type":"text","text":"Spooktacular does them "},{"type":"strong","inlineContent":[{"type":"text","text":"once"}]},{"type":"text","text":":"}],"type":"paragraph"},{"code":["~\/.spooktacular\/cache\/base\/","└── 27A5301a\/                 ← one directory per macOS build","    ├── base.asif             ← macOS installed, provisioner injected, sealed read-only, never booted","    ├── auxiliary.bin         ← cloned into each VM","    ├── hardware-model.bin","    ├── machine-identifier.bin ← the identity the installer personalized against","    └── base.json             ← BaseImageDescriptor"],"syntax":null,"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Each VM is then a thin layer on top:"}],"type":"paragraph"},{"code":["~\/.spooktacular\/vms\/<uuid>.vm\/","├── disk-overlay.asif         ← this VM's writes only; the base stays untouched","├── auxiliary.bin             ← APFS clone of the base's","├── machine-identifier.bin    ← copied from the base, paired with auxiliary.bin","└── metadata.json             ← records the base, subnet and published ports"],"syntax":null,"type":"codeListing"},{"inlineContent":[{"type":"text","text":"This is Apple’s documented DiskImageKit workflow: “a shared, read-only base"},{"type":"text","text":" "},{"type":"text","text":"image with per-VM overlay layers. Each virtual machine gets its own overlay"},{"type":"text","text":" "},{"type":"text","text":"that captures writes while the base remains untouched.”"}],"type":"paragraph"},{"level":2,"text":"Why the first create asks for root","anchor":"Why-the-first-create-asks-for-root","type":"heading"},{"inlineContent":[{"type":"text","text":"The provisioner LaunchDaemon that runs your first-boot script is written into"},{"type":"text","text":" "},{"type":"text","text":"the "},{"type":"strong","inlineContent":[{"type":"text","text":"base image"}]},{"type":"text","text":", as "},{"type":"codeVoice","code":"root:wheel"},{"type":"text","text":", at base-build time. That is the only"},{"type":"text","text":" "},{"type":"text","text":"privileged step in the system, and it happens once per macOS build."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"On an EC2 Mac, where Spooktacular runs as a root service, nothing is ever"},{"type":"text","text":" "},{"type":"text","text":"asked. Locally, either run the first create under "},{"type":"codeVoice","code":"sudo"},{"type":"text","text":", or approve the"},{"type":"text","text":" "},{"type":"text","text":"privileged helper once in System Settings — after which the GUI can build"},{"type":"text","text":" "},{"type":"text","text":"bases itself."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Every create after that is a handful of file operations — an overlay layer and"},{"type":"text","text":" "},{"type":"text","text":"two APFS clones — with "},{"type":"strong","inlineContent":[{"type":"text","text":"one exception worth knowing"}]},{"type":"text","text":". A create that"},{"type":"text","text":" "},{"type":"text","text":"provisions a guest account ("},{"type":"codeVoice","code":"--remote-desktop"},{"type":"text","text":", "},{"type":"codeVoice","code":"--openclaw"},{"type":"text","text":", "},{"type":"codeVoice","code":"--user-data"},{"type":"text","text":", or"},{"type":"text","text":" "},{"type":"text","text":"any "},{"type":"codeVoice","code":"--vm-password"},{"type":"text","text":") stores that account’s password in the root-owned "},{"type":"strong","inlineContent":[{"text":"System","type":"text"}]},{"type":"text","text":" "},{"text":"keychain, so it still needs root even when the base already exists. The","type":"text"},{"text":" ","type":"text"},{"text":"password is written there rather than to ","type":"text"},{"code":"metadata.json","type":"codeVoice"},{"text":" precisely so it never","type":"text"},{"text":" ","type":"text"},{"text":"sits in plaintext on disk; the first ","type":"text"},{"type":"codeVoice","code":"start"},{"type":"text","text":" reads it back, applies it, and"},{"type":"text","text":" "},{"type":"text","text":"deletes it."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Creates that provision no account — a plain "},{"type":"codeVoice","code":"spook create dev2"},{"type":"text","text":", or a"},{"type":"text","text":" "},{"type":"codeVoice","code":"--github-runner"},{"type":"text","text":" create, which mints its credentials at boot instead — need no"},{"type":"text","text":" "},{"type":"text","text":"privileges at all once a base exists."}],"type":"paragraph"},{"level":2,"text":"Why a VM inherits the base’s identity","type":"heading","anchor":"Why-a-VM-inherits-the-bases-identity"},{"inlineContent":[{"type":"codeVoice","code":"VZMacOSInstaller"},{"type":"text","text":" personalizes the auxiliary storage against the machine"},{"type":"text","text":" "},{"type":"text","text":"identifier it runs with, and Apple requires that a VM loaded from disk “restore"},{"type":"text","text":" "},{"type":"text","text":"the "},{"type":"codeVoice","code":"hardwareModel"},{"type":"text","text":", "},{"type":"codeVoice","code":"machineIdentifier"},{"type":"text","text":" and "},{"type":"codeVoice","code":"auxiliaryStorage"},{"type":"text","text":" properties to"},{"type":"text","text":" "},{"type":"text","text":"their original values”. An overlay VM is exactly that disk loaded again, so it"},{"type":"text","text":" "},{"type":"text","text":"copies the base’s identifier rather than minting one: a fresh identifier would"},{"type":"text","text":" "},{"type":"text","text":"pair personalized boot state with an identity it was never signed for."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Apple also warns that running two VMs concurrently with the same identifier is"},{"type":"text","text":" "},{"type":"text","text":"undefined in the guest. Both statements are true at once, and the pairing wins —"},{"type":"text","text":" "},{"type":"text","text":"a VM that cannot boot is worse than one that should not run beside its sibling."},{"type":"text","text":" "},{"type":"text","text":"Each VM does get its own "},{"type":"strong","inlineContent":[{"type":"text","text":"MAC address"}]},{"type":"text","text":", so VMs stay distinct on the network."}],"type":"paragraph"},{"level":2,"text":"Why the base is never booted","type":"heading","anchor":"Why-the-base-is-never-booted"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A base image is installed and then sealed without starting it. Two properties"},{"type":"text","text":" "},{"type":"text","text":"follow, and both matter:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"Its ","type":"text"},{"code":"layerUUID","type":"codeVoice"},{"text":" never changes, so every overlay stacked on it stays valid —","type":"text"},{"text":" ","type":"text"},{"text":"and a pool scrub can ","type":"text"},{"inlineContent":[{"text":"prove","type":"text"}],"type":"emphasis"},{"text":" the base is pristine rather than assume it.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Each VM’s first boot is genuinely the guest’s “first boot after restore”,","type":"text"},{"text":" ","type":"text"},{"text":"which is when ","type":"text"},{"code":"VZMacGuestProvisioningOptions","type":"codeVoice"},{"text":" creates that VM’s own account.","type":"text"},{"text":" ","type":"text"},{"text":"A booted base would have consumed that moment once, for everybody.","type":"text"}],"type":"paragraph"}]}]},{"level":2,"text":"Published ports","anchor":"Published-ports","type":"heading"},{"inlineContent":[{"text":"macOS VMs can expose a guest service on the host, the way ","type":"text"},{"code":"docker -p","type":"codeVoice"},{"text":" does:","type":"text"}],"type":"paragraph"},{"code":["spook create agent --openclaw --publish 18789:18789","open http:\/\/localhost:18789"],"syntax":"bash","type":"codeListing"},{"inlineContent":[{"text":"Each VM gets its own private ","type":"text"},{"type":"codeVoice","code":"\/24"},{"text":" and a DHCP-reserved address, so ","type":"text"},{"type":"codeVoice","code":"spook ip"},{"text":" ","type":"text"},{"text":"is a metadata read rather than a lease-file scrape, and publications become","type":"text"},{"text":" ","type":"text"},{"text":"vmnet forwarding rules pointing at an address known before the VM even starts.","type":"text"},{"text":" ","type":"text"},{"text":"Templates contribute defaults — OpenClaw publishes its gateway automatically —","type":"text"},{"text":" ","type":"text"},{"text":"and an explicit ","type":"text"},{"type":"codeVoice","code":"--publish"},{"text":" on the same host port replaces the default, because","type":"text"},{"text":" ","type":"text"},{"text":"vmnet cannot hold two rules for one host port.","type":"text"}],"type":"paragraph"},{"level":2,"text":"Readiness","anchor":"Readiness","type":"heading"},{"inlineContent":[{"text":"The guest tells the host when provisioning finishes. The last line of the","type":"text"},{"text":" ","type":"text"},{"text":"first-boot script runs a small ","type":"text"},{"type":"codeVoice","code":"spook-signal"},{"text":" binary that dials the host over","type":"text"},{"text":" ","type":"text"},{"text":"vsock with the script’s exit code, so ","type":"text"},{"type":"codeVoice","code":"spook start"},{"text":" prints a definitive result","type":"text"},{"text":" ","type":"text"},{"text":"instead of the host polling for an IP and then for a service and guessing from","type":"text"},{"text":" ","type":"text"},{"text":"a timeout.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"If a base predates the signal binary, or nothing is listening, provisioning","type":"text"},{"text":" ","type":"text"},{"text":"still runs — the first-boot logs in the VM’s ","type":"text"},{"type":"codeVoice","code":"provision\/"},{"text":" directory remain the","type":"text"},{"text":" ","type":"text"},{"text":"record.","type":"text"}],"type":"paragraph"},{"level":2,"text":"Rebuilding a base","anchor":"Rebuilding-a-base","type":"heading"},{"inlineContent":[{"text":"Delete its directory; the next create rebuilds it:","type":"text"}],"type":"paragraph"},{"code":["rm -rf ~\/.spooktacular\/cache\/base\/27A5301a"],"syntax":"bash","type":"codeListing"},{"inlineContent":[{"text":"Bases are also rebuilt automatically when the bundled provisioner changes, so a","type":"text"},{"text":" ","type":"text"},{"text":"VM never silently inherits a stale one.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"metadata":{"modules":[{"name":"SpooktacularKit"}],"roleHeading":"API Collection","role":"collectionGroup","title":"Instant macOS VM Creation"},"variants":[{"paths":["\/documentation\/spooktacularkit\/instantcreate"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"type":"text","text":"How Spooktacular creates macOS VMs in seconds without root, by installing"},{"type":"text","text":" "},{"type":"text","text":"macOS once into a shared base image and giving every VM its own"},{"type":"text","text":" "},{"type":"text","text":"copy-on-write overlay."}],"references":{"doc://spooktacular.SpooktacularKit/documentation/SpooktacularKit/PortPublication":{"kind":"symbol","abstract":[],"identifier":"doc:\/\/spooktacular.SpooktacularKit\/documentation\/SpooktacularKit\/PortPublication","role":"symbol","title":"PortPublication","url":"\/documentation\/spooktacularkit\/portpublication","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"PortPublication","kind":"identifier"}],"type":"topic","navigatorTitle":[{"text":"PortPublication","kind":"identifier"}]},"doc://spooktacular.SpooktacularKit/documentation/SpooktacularKit/BaseImageBuilder":{"identifier":"doc:\/\/spooktacular.SpooktacularKit\/documentation\/SpooktacularKit\/BaseImageBuilder","kind":"symbol","role":"symbol","url":"\/documentation\/spooktacularkit\/baseimagebuilder","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"BaseImageBuilder"}],"type":"topic","navigatorTitle":[{"kind":"identifier","text":"BaseImageBuilder"}],"title":"BaseImageBuilder","abstract":[]},"doc://spooktacular.SpooktacularKit/documentation/SpooktacularKit/GuestNetworkAllocation":{"type":"topic","url":"\/documentation\/spooktacularkit\/guestnetworkallocation","kind":"symbol","title":"GuestNetworkAllocation","role":"symbol","abstract":[],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"GuestNetworkAllocation"}],"navigatorTitle":[{"kind":"identifier","text":"GuestNetworkAllocation"}],"identifier":"doc:\/\/spooktacular.SpooktacularKit\/documentation\/SpooktacularKit\/GuestNetworkAllocation"},"doc://spooktacular.SpooktacularKit/documentation/SpooktacularKit/LinuxProvisioning":{"type":"topic","url":"\/documentation\/spooktacularkit\/linuxprovisioning","kind":"article","title":"Linux Provisioning","role":"article","abstract":[{"text":"Provision Linux guests on first boot with cloud-init — account, SSH, and","type":"text"},{"text":" ","type":"text"},{"text":"first-boot scripts, with no installer walkthrough and no root on the host.","type":"text"}],"identifier":"doc:\/\/spooktacular.SpooktacularKit\/documentation\/SpooktacularKit\/LinuxProvisioning"},"doc://spooktacular.SpooktacularKit/documentation/SpooktacularKit":{"identifier":"doc:\/\/spooktacular.SpooktacularKit\/documentation\/SpooktacularKit","kind":"symbol","role":"collection","url":"\/documentation\/spooktacularkit","type":"topic","title":"SpooktacularKit","abstract":[{"type":"text","text":"Create and manage macOS virtual machines on Apple Silicon."}]},"doc://spooktacular.SpooktacularKit/documentation/SpooktacularKit/BaseImageDescriptor":{"type":"topic","url":"\/documentation\/spooktacularkit\/baseimagedescriptor","kind":"symbol","title":"BaseImageDescriptor","role":"symbol","abstract":[],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"BaseImageDescriptor"}],"navigatorTitle":[{"kind":"identifier","text":"BaseImageDescriptor"}],"identifier":"doc:\/\/spooktacular.SpooktacularKit\/documentation\/SpooktacularKit\/BaseImageDescriptor"},"doc://spooktacular.SpooktacularKit/documentation/SpooktacularKit/JenkinsGuide":{"kind":"article","identifier":"doc:\/\/spooktacular.SpooktacularKit\/documentation\/SpooktacularKit\/JenkinsGuide","abstract":[{"text":"Run Jenkins build agents in Spooktacular VMs for iOS and macOS CI\/CD.","type":"text"}],"role":"collectionGroup","title":"Configuring Jenkins Nodes","url":"\/documentation\/spooktacularkit\/jenkinsguide","type":"topic"},"doc://spooktacular.SpooktacularKit/documentation/SpooktacularKit/Provisioning":{"kind":"article","identifier":"doc:\/\/spooktacular.SpooktacularKit\/documentation\/SpooktacularKit\/Provisioning","abstract":[{"type":"text","text":"Run scripts automatically when a VM boots."}],"role":"collectionGroup","title":"Provisioning Virtual Machines","url":"\/documentation\/spooktacularkit\/provisioning","type":"topic"},"doc://spooktacular.SpooktacularKit/documentation/SpooktacularKit/OpenClawGuide"