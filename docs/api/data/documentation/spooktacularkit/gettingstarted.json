{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/spooktacular.SpooktacularKit\/documentation\/SpooktacularKit\/GettingStarted"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/spooktacularkit\/gettingstarted"]}],"topicSections":[{"title":"Core Types","anchor":"Core-Types","identifiers":["doc:\/\/spooktacular.SpooktacularKit\/documentation\/SpooktacularKit\/VirtualMachineBundle","doc:\/\/spooktacular.SpooktacularKit\/documentation\/SpooktacularKit\/VirtualMachineSpecification","doc:\/\/spooktacular.SpooktacularKit\/documentation\/SpooktacularKit\/VirtualMachine"]},{"title":"Configuration","anchor":"Configuration","identifiers":["doc:\/\/spooktacular.SpooktacularKit\/documentation\/SpooktacularKit\/VirtualMachineConfiguration","doc:\/\/spooktacular.SpooktacularKit\/documentation\/SpooktacularKit\/NetworkMode","doc:\/\/spooktacular.SpooktacularKit\/documentation\/SpooktacularKit\/ProvisioningMode"]},{"title":"Guides","anchor":"Guides","identifiers":["doc:\/\/spooktacular.SpooktacularKit\/documentation\/SpooktacularKit\/CLIReference","doc:\/\/spooktacular.SpooktacularKit\/documentation\/SpooktacularKit\/Provisioning","doc:\/\/spooktacular.SpooktacularKit\/documentation\/SpooktacularKit\/GitHubActionsGuide","doc:\/\/spooktacular.SpooktacularKit\/documentation\/SpooktacularKit\/EC2MacDeployment"]}],"kind":"article","seeAlsoSections":[{"generated":true,"title":"Guides","anchor":"Guides","identifiers":["doc:\/\/spooktacular.SpooktacularKit\/documentation\/SpooktacularKit\/InstantCreate","doc:\/\/spooktacular.SpooktacularKit\/documentation\/SpooktacularKit\/Provisioning","doc:\/\/spooktacular.SpooktacularKit\/documentation\/SpooktacularKit\/LinuxProvisioning","doc:\/\/spooktacular.SpooktacularKit\/documentation\/SpooktacularKit\/CLIReference","doc:\/\/spooktacular.SpooktacularKit\/documentation\/SpooktacularKit\/GitHubActionsGuide","doc:\/\/spooktacular.SpooktacularKit\/documentation\/SpooktacularKit\/JenkinsGuide","doc:\/\/spooktacular.SpooktacularKit\/documentation\/SpooktacularKit\/EC2MacDeployment","doc:\/\/spooktacular.SpooktacularKit\/documentation\/SpooktacularKit\/MLWorkloads","doc:\/\/spooktacular.SpooktacularKit\/documentation\/SpooktacularKit\/RemoteDesktop","doc:\/\/spooktacular.SpooktacularKit\/documentation\/SpooktacularKit\/OpenClawGuide","doc:\/\/spooktacular.SpooktacularKit\/documentation\/SpooktacularKit\/BlueBubblesGuide","doc:\/\/spooktacular.SpooktacularKit\/documentation\/SpooktacularKit\/Versioning"]}],"sections":[],"metadata":{"role":"collectionGroup","modules":[{"name":"SpooktacularKit"}],"title":"Getting Started with Spooktacular","roleHeading":"API Collection"},"schemaVersion":{"minor":3,"patch":0,"major":0},"primaryContentSections":[{"kind":"content","content":[{"level":2,"text":"Overview","type":"heading","anchor":"Overview"},{"inlineContent":[{"type":"text","text":"Spooktacular runs macOS virtual machines on Apple Silicon using"},{"type":"text","text":" "},{"type":"text","text":"Apple’s Virtualization framework. You interact with it through the"},{"type":"text","text":" "},{"type":"text","text":"GUI app or the "},{"type":"codeVoice","code":"spook"},{"type":"text","text":" CLI — both backed by the same"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/spooktacular.SpooktacularKit\/documentation\/SpooktacularKit","isActive":true},{"type":"text","text":" library."}],"type":"paragraph"},{"style":"important","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"You need an Apple Silicon Mac (M1 or later) running"},{"type":"text","text":" "},{"type":"text","text":"macOS 26.0 or later. Each VM requires at least 20 GB of"},{"type":"text","text":" "},{"type":"text","text":"free disk space and 4 CPU cores (see"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/spooktacular.SpooktacularKit\/documentation\/SpooktacularKit\/VirtualMachineSpecification\/minimumCPUCount","isActive":true},{"type":"text","text":")."}]}],"name":"Important","type":"aside"},{"level":3,"text":"Creating a VM with the CLI","type":"heading","anchor":"Creating-a-VM-with-the-CLI"},{"inlineContent":[{"type":"text","text":"Install Spooktacular and create a VM from the latest compatible IPSW:"}],"type":"paragraph"},{"syntax":"bash","code":["# Build from source — signed releases aren't published yet","git clone https:\/\/github.com\/Spooky-Labs\/spooktacular.git","cd spooktacular",".\/build-app.sh release","","# Create from the latest compatible IPSW","spook create my-vm --from-ipsw latest","","# Or specify custom hardware resources","spook create runner --cpu 8 --memory 16 --disk 100"],"type":"codeListing"},{"style":"note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"emphasis","inlineContent":[{"text":"first","type":"text"}]},{"type":"text","text":" macOS create installs macOS into a shared base image,"},{"type":"text","text":" "},{"type":"text","text":"which takes 10–20 minutes and needs root once. Every create after that"},{"text":" ","type":"text"},{"text":"is an overlay layer on that base and takes seconds. ","type":"text"},{"type":"codeVoice","code":"spook clone"},{"text":" is","type":"text"},{"text":" ","type":"text"},{"text":"faster still — a measured 30 ms for a 5 GB VM, using no extra disk,","type":"text"},{"type":"text","text":" "},{"type":"text","text":"because APFS shares the blocks. See "},{"type":"reference","isActive":true,"identifier":"doc:\/\/spooktacular.SpooktacularKit\/documentation\/SpooktacularKit\/InstantCreate"},{"text":".","type":"text"}]}],"name":"Note","type":"aside"},{"level":3,"text":"Creating a VM with the GUI","type":"heading","anchor":"Creating-a-VM-with-the-GUI"},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"Open Spooktacular."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Click the ","type":"text"},{"inlineContent":[{"text":"+","type":"text"}],"type":"strong"},{"text":" button or press ","type":"text"},{"type":"strong","inlineContent":[{"text":"Cmd+N","type":"text"}]},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Enter a name and adjust hardware settings.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Click ","type":"text"},{"inlineContent":[{"text":"Create","type":"text"}],"type":"strong"},{"type":"text","text":"."}]}]}]},{"type":"paragraph","inlineContent":[{"text":"The app downloads the latest compatible macOS IPSW and, the first time,","type":"text"},{"text":" ","type":"text"},{"text":"installs it into the shared base image; later creates reuse that base.","type":"text"}]},{"type":"heading","anchor":"Managing-VMs","level":3,"text":"Managing VMs"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use the "},{"type":"codeVoice","code":"spook"},{"type":"text","text":" CLI for day-to-day VM management:"}]},{"type":"codeListing","syntax":"bash","code":["# List all VMs","spook list","","# Start a VM (opens display window)","spook start my-vm","","# Start headless (for CI runners and servers)","spook start my-vm --headless","","# Clone instantly using APFS copy-on-write","spook clone my-vm runner-01","","# Show VM configuration","spook get my-vm","","# Delete a VM permanently","spook delete my-vm --force"]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Apple Silicon supports a maximum of 2 concurrent VMs","type":"text"},{"text":" ","type":"text"},{"text":"per host. Attempting to start a third VM fails. See","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/spooktacular.SpooktacularKit\/documentation\/SpooktacularKit\/CapacityCheck","type":"reference","isActive":true},{"text":" for details.","type":"text"}]}],"type":"aside","name":"Important","style":"important"},{"type":"heading","anchor":"Provisioning-with-User-Data-Scripts","level":3,"text":"Provisioning with User-Data Scripts"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Automate VM setup by running a shell script after boot via SSH:"}]},{"type":"codeListing","syntax":"bash","code":["spook start runner --headless \\","    --user-data ~\/setup.sh \\","    --provision ssh \\","    --ssh-user admin"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"ssh"},{"type":"text","text":" mode waits for the VM to boot, discovers its IP, connects"},{"type":"text","text":" "},{"type":"text","text":"via SSH, and executes your script with real-time output streaming."},{"type":"text","text":" "},{"type":"codeVoice","code":"--provision disk-inject"},{"type":"text","text":" (the default) is zero-touch and needs no"},{"type":"text","text":" "},{"type":"text","text":"SSH — it injects the script into the VM’s disk image before first"},{"type":"text","text":" "},{"type":"text","text":"boot via a LaunchDaemon. "},{"type":"codeVoice","code":"--provision shared-folder"},{"type":"text","text":" is not yet"},{"type":"text","text":" "},{"type":"text","text":"available. See "},{"type":"reference","identifier":"doc:\/\/spooktacular.SpooktacularKit\/documentation\/SpooktacularKit\/ProvisioningMode","isActive":true},{"type":"text","text":" for provisioning strategies and"},{"type":"text","text":" "},{"identifier":"doc:\/\/spooktacular.SpooktacularKit\/documentation\/SpooktacularKit\/Provisioning","type":"reference","isActive":true},{"text":" for detailed guidance.","type":"text"}]},{"type":"heading","anchor":"EC2-Mac-Setup","level":3,"text":"EC2 Mac Setup"},{"type":"paragraph","inlineContent":[{"text":"Deploy Spooktacular on AWS EC2 Mac instances to double your CI","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"capacity. Install Spooktacular, create VMs from IPSW, clone"},{"type":"text","text":" "},{"type":"text","text":"configured bases, and start runners with SSH provisioning."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"See "},{"type":"reference","identifier":"do