<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "https://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Privileged helper daemon registered via
         SMAppService.daemon(plistName:). BundleProgram is relative to
         the app bundle root (Apple's SMAppService sample layout);
         launchd bootstraps it as root after one-time admin approval in
         System Settings → Login Items. -->
    <key>Label</key>
    <string>com.spooktacular.app.helper</string>
    <key>BundleProgram</key>
    <string>Contents/MacOS/spooktacular-helper</string>
    <key>MachServices</key>
    <dict>
        <key>com.spooktacular.app.helper</key>
        <true/>
    </dict>
    <key>AssociatedBundleIdentifiers</key>
    <array>
        <string>com.spooktacular.app</string>
    </array>
</dict>
</plist>
